{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ottovonwasgibt/VIBE-optimizer/blob/main/schemas/private-source-manifest.schema.json",
  "title": "Private Source Manifest — illustrative contract",
  "description": "Describes restricted-source provenance and proposed rights; NOT proof of approval. Trusted institutional systems must authorize use independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "classification",
    "tenant",
    "owner",
    "version",
    "status",
    "purpose_allowlist",
    "role_allowlist",
    "destination_allowlist",
    "rights"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "description": "Opaque reference; no internal address or secret needed in public manifests"
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "RESTRICTED",
        "CONFIDENTIAL",
        "PERSONAL",
        "SECRET"
      ]
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "staged",
        "approved",
        "revoked"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "purpose_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "role_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "destination_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "model_excerpt"
      ],
      "properties": {
        "index": {
          "enum": [
            "pending",
            "approved",
            "denied"
          ]
        },
        "model_excerpt": {
          "enum": [
            "pending",
            "approved",
            "denied"
          ]
        }
      }
    }
  }
}
